# =============================================================================
# HOSPITAL AI AGENT SYSTEM - CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholder values with your credentials
# =============================================================================

# 📧 Email & Hospital Communication
HOSPITAL_EMAIL=admin@hospital.com
GMAIL_USER=admin@hospital.com
HOSPITAL_PHONE=+91-9876543210
PATIENT_TEST_PHONE=+91-9876543211

# 🔒 Google Cloud Service Account (JSON file path)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/client_secret.json

# 🔑 Google OAuth 2.0 Configuration (for user login & workspace integrations)
# Setup at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# 📁 Google Drive Configuration
HOSPITAL_DRIVE_FOLDER_NAME=Hospital_AI_Patient_Documents

# 📊 Google Sheets Configuration (Spreadsheet IDs from Google Sheets URL)
PATIENT_TRACKING_SHEET_ID=your_patient_tracking_sheet_id
LAB_RESULTS_SHEET_ID=your_lab_results_sheet_id

# 💰 Billing & Financial Sheets
BILLING_SHEET_ID=your_billing_sheet_id
INVOICE_SHEET_ID=your_invoice_sheet_id
PAYMENT_TRACKING_SHEET_ID=your_payment_tracking_sheet_id

# 🏥 Hospital Staff-Agent Communication Sheets
PATIENT_STATUS_SHEET_ID=your_patient_status_sheet_id
DOCTOR_NOTES_SHEET_ID=your_doctor_notes_sheet_id
LAB_RESULTS_MONITORING_SHEET_ID=your_lab_monitoring_sheet_id
STAFF_UPDATES_SHEET_ID=your_staff_updates_sheet_id
EMERGENCY_ALERTS_SHEET_ID=your_emergency_alerts_sheet_id
PHARMACY_INVENTORY_SHEET_ID=your_pharmacy_inventory_sheet_id

# 📅 Google Calendar Configuration
HOSPITAL_CALENDAR_ID=primary

# 💾 Database Configuration
DATABASE_PATH=database/hospital.db
DATABASE_TYPE=json  # 'json' or 'postgresql'

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hospital_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Redis Configuration (Cache & Session Persistence)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 🏥 Hospital Information
HOSPITAL_NAME=City General Hospital
HOSPITAL_ADDRESS=123 Medical Center Blvd, Healthcare City
HOSPITAL_WEBSITE=https://hospital.example.com

# 🔧 Application Configuration
DEBUG=True
ENVIRONMENT=development

# 💬 Twilio Configuration (SMS & WhatsApp notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_phone_number
